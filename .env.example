# Токен доступа к https://food-tracker.pht.space — уходит в заголовок `Authorization: Secret <token>`.
# Живёт около трёх часов: если сборка сообщает 401, впишите свежий.
FOOD_TRACKER_ACCESS_TOKEN=

# Refresh-токен. Сохраняется на будущее: эндпоинт обновления пока неизвестен,
# автообновление не подключено.
FOOD_TRACKER_REFRESH_TOKEN=

# Опорный день. По умолчанию — дата сборки: его неделя показывается первой.
# BOARD_DATE=2026-08-01

# Сколько прошлых недель добавить к текущей. 1 = текущая + прошлая (14 дат).
BOARD_WEEKS_BACK=1

# Передаётся в параметр week_render как есть.
BOARD_WEEK_RENDER=20

# Нормы по калориям и БЖУ — эндпоинт их не отдаёт.
BOARD_CALORIE_GOAL=2700
BOARD_CARB_TARGET=300
BOARD_PROTEIN_TARGET=180
BOARD_FAT_TARGET=90

# 1 — собирать из .cache/, не обращаясь к сети.
BOARD_OFFLINE=0
