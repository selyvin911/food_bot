---
import Base from '../layouts/Base.astro';
import { asset } from '../lib/url';
import { DEVELOPER } from '../data/config';

const year = new Date().getFullYear();
---

<Base
  title={DEVELOPER}
  description={`${DEVELOPER} — indie app developer. Privacy policies and terms of service for the apps.`}
>
  <div class="page">
    <main>
      <section class="hero">
        <img class="hero__avatar" src={asset('avatar.webp')} alt="" width="96" height="96" />
        <h1 class="hero__name">{DEVELOPER}</h1>
        <p class="hero__role">Indie app developer</p>
        <p class="hero__text">
          I design and build small, focused mobile apps. This site hosts the
          legal documents for my apps on the App&nbsp;Store and Google&nbsp;Play.
        </p>
      </section>

      <section class="apps" aria-label="Apps">
        <h2 class="apps__label">Apps</h2>

        <article class="app-card">
          <div class="app-card__head">
            <div class="app-card__icon" aria-hidden="true">🍳</div>
            <div>
              <h3 class="app-card__name">Menushka</h3>
              <p class="app-card__platform">iOS</p>
            </div>
          </div>
          <p class="app-card__about">
            Save recipes, plan a weekly menu and build a shopping list — with
            recipe import from public TikTok videos and Telegram posts.
          </p>
          <ul class="app-card__links">
            <li class="doc-link">
              <a class="doc-link__title" href={asset('menushka/privacy.html')}>Privacy Policy</a>
              <span class="doc-link__langs">
                <a href={asset('menushka/privacy.html')}>EN</a>
                <a href={asset('menushka/privacy-ru.html')}>RU</a>
              </span>
            </li>
            <li class="doc-link">
              <a class="doc-link__title" href={asset('menushka/terms.html')}>Terms of Service</a>
              <span class="doc-link__langs">
                <a href={asset('menushka/terms.html')}>EN</a>
                <a href={asset('menushka/terms-ru.html')}>RU</a>
              </span>
            </li>
          </ul>
        </article>
      </section>
    </main>

    <footer class="site-foot">
      <span>© {year} {DEVELOPER}</span>
      <span>ymaxim.com</span>
    </footer>
  </div>
</Base>
