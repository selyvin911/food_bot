---
import { RING_RADIUS, type RingModel } from '../data/derive';
import { UI } from '../data/strings';

interface Props extends RingModel {
  color: string;
}

const { value, goal, dash, visible, caption, color } = Astro.props;
---

<div class="ring">
  <div class="ring__dial">
    <svg class="ring__svg" viewBox="0 0 120 120" aria-hidden="true">
      <circle cx="60" cy="60" r={RING_RADIUS} fill="none" stroke="var(--line)" stroke-width="12"></circle>
      <circle
        cx="60"
        cy="60"
        r={RING_RADIUS}
        fill="none"
        stroke={visible ? color : 'transparent'}
        stroke-width="12"
        stroke-linecap="round"
        stroke-dasharray={dash}></circle>
    </svg>
    <div class="ring__center">
      <p class="ring__value">{value}</p>
      {goal && <p class="ring__goal">{UI.rings.of} {goal}</p>}
    </div>
  </div>
  <p class="ring__caption" style={`color:${color}`}>{caption}</p>
</div>
