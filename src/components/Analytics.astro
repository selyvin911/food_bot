---
import { METRIKA_ID } from '../data/config';

// Только в собранной версии: в dev-режиме счётчик портил бы статистику.
const enabled = import.meta.env.PROD && METRIKA_ID > 0;
---

{
  enabled && (
    <Fragment>
      {/*
        Сниппет Яндекс.Метрики. is:inline обязателен — Astro не должен его
        собирать в модуль. Внутри такого тега содержимое остаётся сырым
        текстом, поэтому фигурные скобки и выражения тут не подставляются:
        номер счётчика приходит через define:vars как const id.
      */}
      <script is:inline define:vars={{ id: METRIKA_ID }}>
        (function(m,e,t,r,i,k,a){ m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date(); for (var j = 0; j < document.scripts.length; j++) {if
        (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
        })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=' + id, 'ym'); ym(id,
        'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer:
        document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
      </script>

      <noscript>
        <div>
          <img
            src={`https://mc.yandex.ru/watch/${METRIKA_ID}`}
            style="position:absolute; left:-9999px;"
            alt=""
          />
        </div>
      </noscript>
    </Fragment>
  )
}
