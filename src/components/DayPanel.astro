---
import type { Day } from '../data/diary';
import EmptyDay from './EmptyDay.astro';
import MealCard from './MealCard.astro';
import SummaryCard from './SummaryCard.astro';

interface Props {
  day: Day;
  index: number;
  active: boolean;
}

const { day, index, active } = Astro.props;
---

<!-- All seven panels are in the HTML; the week strip only flips which is hidden. -->
<section
  class="day-panel"
  id={`day-panel-${index}`}
  role="tabpanel"
  aria-labelledby={`day-tab-${index}`}
  data-day-panel={index}
  data-active={active ? '' : undefined}
  hidden={!active}
>
  <SummaryCard day={day} />

  {day.meals.length === 0 && <EmptyDay text={day.note} />}

  {day.meals.map((meal) => <MealCard meal={meal} />)}
</section>
