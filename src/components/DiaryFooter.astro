---
import { UI } from '../data/strings';

interface Props {
  generatedAt: string;
}

const { generatedAt } = Astro.props;
---

<footer class="diary-foot">
  <p class="diary-foot__note">{UI.footer.generated(generatedAt)}</p>
  <p class="diary-foot__cta"><a href="#">{UI.footer.cta}</a></p>
</footer>
