---
import { UI } from '../data/strings';

interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div class="block">
  <section class="card card--flat empty">
    <div class="empty__glyph" aria-hidden="true">·</div>
    <h3 class="empty__title">{UI.empty.title}</h3>
    <p class="empty__text">{text}</p>
  </section>
</div>
