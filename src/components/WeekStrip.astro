---
import type { WeekGroup } from '../data/diary';
import { UI } from '../data/strings';

interface Props {
  weeks: WeekGroup[];
  selected: number;
}

const { weeks, selected } = Astro.props;

// Открываемся на неделе выбранного дня — она последняя, если данные свежие.
const initialPage = Math.max(
  0,
  weeks.findIndex((week) => week.days.some((day) => day.index === selected)),
);
---

<!--
  Недели — страницы горизонтальной карусели, от старых к новым: свайп на
  телефоне, стрелки на десктопе. Один tablist на все недели, чтобы стрелки
  клавиатуры шли насквозь.
-->
<div class="weeks" data-weeks data-initial-page={initialPage}>
  <div class="weeks__track" role="tablist" aria-label={UI.week.tablistLabel} data-week>
    {
      weeks.map((week) => (
        <section class="week">
          <div class="week__head">
            <button
              class="week__nav"
              type="button"
              data-week-nav="-1"
              aria-label={UI.week.older}
              hidden={weeks.length < 2}
            >
              <span aria-hidden="true">‹</span>
            </button>

            <p class="week__range">{week.range}</p>

            <button
              class="week__nav"
              type="button"
              data-week-nav="1"
              aria-label={UI.week.newer}
              hidden={weeks.length < 2}
            >
              <span aria-hidden="true">›</span>
            </button>
          </div>

          <div class="week__strip">
            {week.days.map((day) => (
              <button
                type="button"
                class:list={[
                  'chip',
                  {
                    'chip--future': day.future,
                    'chip--empty': day.meals.length === 0,
                    'chip--today': day.isToday,
                  },
                ]}
                role="tab"
                id={`day-tab-${day.index}`}
                aria-controls={`day-panel-${day.index}`}
                aria-selected={day.index === selected ? 'true' : 'false'}
                tabindex={day.index === selected ? 0 : -1}
                data-day={day.index}
              >
                <span class="chip__dow">{day.dow}</span>
                <span class="chip__num">{day.dayNum}</span>
                <span class="chip__dot" aria-hidden="true" />
                <span class="u-sr-only">{day.label}</span>
              </button>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</div>

<script>
  // Начальная страница и стрелки. Свайп и scroll-snap работают без JS.
  const shell = document.querySelector<HTMLElement>('[data-weeks]');
  const track = document.querySelector<HTMLElement>('[data-week]');

  if (shell && track) {
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth - 1;
      shell.classList.toggle('weeks--at-start', track.scrollLeft <= 1);
      shell.classList.toggle('weeks--at-end', track.scrollLeft >= max);
    };

    // Мгновенно, без анимации — это стартовое положение, а не переход.
    track.scrollLeft = Number(shell.dataset.initialPage ?? 0) * track.clientWidth;

    shell.querySelectorAll<HTMLButtonElement>('[data-week-nav]').forEach((button) => {
      button.addEventListener('click', () => {
        const direction = Number(button.dataset.weekNav);
        track.scrollBy({ left: direction * track.clientWidth, behavior: 'smooth' });
      });
    });

    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }
</script>
